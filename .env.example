# Moasist — variables de entorno
#
# Copia este archivo a `.env` y completa los valores.
#   cp .env.example .env
#
# `.env` está en .gitignore: nunca subas secretos reales al repositorio.

# ─── Base de datos ────────────────────────────────────────────────────────────
# Si la defines, la app usa Postgres (Neon, Supabase, RDS, local…): los datos
# PERSISTEN entre reinicios.
# Si la dejas vacía, usa PGLite embebido EN MEMORIA: funciona al instante, pero
# los datos se borran cada vez que reinicias el servidor (solo para demos).
#
# Con DATABASE_URL definido, aplica el esquema una vez con:  npm run db:migrate
# (en el deploy, `npm run build` ya lo hace automáticamente).
DATABASE_URL=

# ─── Administrador (bootstrap) ────────────────────────────────────────────────
# Contraseña inicial de la cuenta de Administración. Si la dejas vacía, se
# genera una aleatoria y se imprime en la consola del servidor al primer login.
# El sistema obliga a cambiarla en el primer ingreso.
MOASIST_ADMIN_PASSWORD=

# ─── Consulta de RUC (opcional) ───────────────────────────────────────────────
# Al crear una empresa, la app consulta SUNAT por el RUC para autocompletar la
# razón social, la dirección y el estado. Por defecto usa el proveedor público
# apis.net.pe, que funciona sin llave (con cuota limitada). Para producción,
# contrata un plan y pega aquí tu token: la consulta corre en el SERVIDOR, así
# que el token nunca llega al navegador.
#   RUC_API_ENDPOINT=https://api.apis.net.pe/v2/ruc
#   RUC_API_TOKEN=
RUC_API_ENDPOINT=
RUC_API_TOKEN=

# ─── Flags de app (opcional) ──────────────────────────────────────────────────
# "false" desactiva la pantalla de inicio de sesión de la plantilla base.
# Moasist tiene su propio login, así que normalmente se deja sin definir.
# VITE_AUTH_ENABLED=false

# ─── Better Auth (opcional) ───────────────────────────────────────────────────
# Solo si habilitas la capa de autenticación de la plantilla base.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
